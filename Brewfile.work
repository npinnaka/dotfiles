# Work-only dependencies (installed after Brewfile.common for the `work` profile)

# Apps
cask "claude-code"
cask "corretto@21"
if ENV.fetch("DOTFILES_GUI", "desktop") == "desktop"
  cask "pgadmin4"
end

# JVM / build
brew "groovy"
brew "jenv"

# Node / JS toolchain
brew "node"
brew "nodenv"
brew "prettier"
brew "tsc"

# Infra / CLI
brew "vault"
brew "yq"
