# Ghostty macOS Configuration

config-file = common.conf

# macOS Specific Window Styling
window-save-state = always
background-blur-radius = 20
macos-titlebar-style = transparent

# Quick terminal (Ctrl+` from anywhere)
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# macOS Command-key navigation variants
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F
