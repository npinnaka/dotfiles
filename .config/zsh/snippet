# .zshrc snippets for Ghostty and Homebrew tools

# Homebrew setup and Path
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if command -v brew &> /dev/null; then
  BREW_PREFIX=$(brew --prefix)
fi

# Path
# Ensure Homebrew paths are prioritized by being at the beginning,
# but eval brew shellenv usually handles this.
# We explicitly put user-local and homebrew bins first.
#   $HOME/.local/bin : user-installed CLIs (pip --user, pipx, uv, npm --prefix, etc.)
#   $HOME/bin        : personal scripts
#   $HOME/.docker/bin: Docker Desktop CLI plugins
#   $HOME/go/bin     : Go-installed binaries (go install ...)
#   $HOME/.cargo/bin : Rust/Cargo-installed binaries
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.docker/bin:$HOME/go/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Set Homebrew Cask environment
# Install casks into the user's ~/Applications so install/uninstall never needs sudo.
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

#Set Anthropic TOKEN
export ANTHROPIC_AUTH_TOKEN=""

# zsh-autocomplete (must be near top)
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
fi

# zsh-autosuggestions
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-you-should-use
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-you-should-use/you-should-use.plugin.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-you-should-use/you-should-use.plugin.zsh"
fi

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Starship prompt
if command -v starship &> /dev/null; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  eval "$(starship init zsh)"
fi

# Modern replacements
alias ls="eza --icons"
alias ll="eza --icons -la"
alias lt="eza --icons --tree --level=2"
alias cat="bat"

# git-delta (handled via git config, but good to have)
if command -v delta &> /dev/null; then
  export GIT_PAGER="delta"
fi

# kubernetes-cli (kubectl) completions and alias
if command -v kubectl &> /dev/null; then
  source <(kubectl completion zsh)
  alias k="kubectl"
  compdef k=kubectl
fi

# zsh-syntax-highlighting (must be last)
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Python Virtual Environment
if [[ -d "$HOME/.venv" && -f "$HOME/.venv/bin/activate" ]]; then
  source "$HOME/.venv/bin/activate"
fi
