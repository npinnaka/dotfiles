# .zshrc snippet managed by dotfiles

# Homebrew setup (macOS)
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if command -v brew &> /dev/null; then
  BREW_PREFIX=$(brew --prefix)
fi

# PATH: Prioritize user-local bins, runtime paths, and platform defaults
#   $HOME/.local/bin : user-installed CLIs (uv, pipx, local releases)
#   $HOME/bin        : personal scripts
#   $HOME/.docker/bin: Docker CLI plugins
#   $HOME/go/bin     : Go-installed binaries
#   $HOME/.cargo/bin : Rust/Cargo binaries
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.docker/bin:$HOME/go/bin:$HOME/.cargo/bin${BREW_PREFIX:+:$BREW_PREFIX/bin:$BREW_PREFIX/sbin}:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# macOS Homebrew Cask options (apps in user directory)
if [[ "$(uname -s)" == "Darwin" ]]; then
  export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"
fi

# Anthropic Auth Token (optional user setting)
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-}"

# zsh-autocomplete (must be sourced near top)
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
elif [[ -f /usr/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh ]]; then
  source /usr/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
fi

# zsh-autosuggestions
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-you-should-use
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-you-should-use/you-should-use.plugin.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-you-should-use/you-should-use.plugin.zsh"
elif [[ -f /usr/share/zsh-you-should-use/you-should-use.plugin.zsh ]]; then
  source /usr/share/zsh-you-should-use/you-should-use.plugin.zsh
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-you-should-use/you-should-use.plugin.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-you-should-use/you-should-use.plugin.zsh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-you-should-use/you-should-use.plugin.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-you-should-use/you-should-use.plugin.zsh"
fi

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Starship prompt
if command -v starship &> /dev/null; then
  export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
  eval "$(starship init zsh)"
fi

# Modern CLI replacements and aliases
if command -v eza &> /dev/null; then
  alias ls="eza --icons"
  alias ll="eza --icons -la"
  alias lt="eza --icons --tree --level=2"
fi

if command -v bat &> /dev/null; then
  alias cat="bat"
elif command -v batcat &> /dev/null; then
  alias cat="batcat"
fi

# git-delta pager
if command -v delta &> /dev/null; then
  export GIT_PAGER="delta"
fi

# kubernetes-cli (kubectl) completions and alias
if command -v kubectl &> /dev/null; then
  source <(kubectl completion zsh)
  alias k="kubectl"
  compdef k=kubectl 2>/dev/null || true
fi

# zsh-syntax-highlighting (must be sourced last)
if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Python Virtual Environment autoload
if [[ -d "$HOME/.venv" && -f "$HOME/.venv/bin/activate" ]]; then
  source "$HOME/.venv/bin/activate"
fi
