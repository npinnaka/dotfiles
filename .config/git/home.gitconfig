# Home git identity
# Included globally by setup.sh when running `./setup.sh home`.
# Edit the values below to match your personal account.

[user]
	name = Your Name
	email = you@personal.example
	# Optional commit signing:
	# signingkey = YOUR_GPG_OR_SSH_KEY

# Uncomment to sign commits by default for this profile:
# [commit]
# 	gpgsign = true
