# Common Brewfile shared across all environments
# Installed via `brew bundle` for both the home and work profiles.

# Apps (casks)
cask "bruno"
cask "docker-desktop"
cask "ghostty"
cask "github"
cask "jetbrains-toolbox"
cask "zed"

# Fonts
cask "font-jetbrains-mono-nerd-font"

# Languages & runtimes
brew "go"
brew "python"
brew "uv"

# Cloud / infra
brew "awscli"
brew "opentofu"
brew "protobuf"

# Shell plugins
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-you-should-use"

# Prompt
brew "starship"

# Tools
brew "bat"
brew "btop"
brew "dust"
brew "eza"
brew "fzf"
brew "git-delta"
brew "jq"
brew "lazygit"
brew "ripgrep"
brew "tree"
brew "yazi"
brew "zoxide"
