# Common Brewfile shared across all environments
# Installed via `brew bundle` for both the home and work profiles.

if ENV.fetch("DOTFILES_GUI", "desktop") == "desktop"
  # Apps (casks)
  cask "bruno"
  cask "podman-desktop"
  cask "ghostty"
  cask "github"
  cask "jetbrains-toolbox"
  cask "lapce"

  # Fonts
  cask "font-jetbrains-mono-nerd-font"
end

# Languages & runtimes
brew "go"
brew "python"
brew "uv"

# Cloud / infra
brew "awscli"
brew "kind"
brew "kubernetes-cli"
brew "opentofu"
brew "podman"
brew "podman-compose"
brew "protobuf"

# Shell plugins
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-you-should-use"

# Prompt
brew "starship"

# Tools
brew "bat"
brew "btop"
brew "dust"
brew "eza"
brew "fzf"
brew "gh"
brew "git-delta"
brew "jq"
brew "lazygit"
brew "ripgrep"
brew "tree"
brew "yazi"
brew "zoxide"
brew "rtk"
